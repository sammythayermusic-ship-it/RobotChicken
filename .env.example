# COCKFIGHT environment. Nothing here is required for local dev: every process
# boots with zero env vars (see packages/shared/src/env.ts). Secrets go into
# Fly / Vercel secrets, never into git. Where = which deployables read it.

# --- web: public (inlined at build; read only via literal process.env.NEXT_PUBLIC_X) ---
NEXT_PUBLIC_GAME_WS_URL=ws://localhost:2567    # web. Game server; prod wss://cockfight-game.fly.dev (its http twin serves /gate, /config, /api/*)
NEXT_PUBLIC_COCK_MINT=                         # web, game, worker. $COCK mint, set at launch
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                # web. Defaults to Cloudflare's always-pass test key in dev
NEXT_PUBLIC_SUPABASE_URL=                      # web. Replay page + leaderboard read the public views (else the game server's memory)
NEXT_PUBLIC_SUPABASE_ANON_KEY=                 # web. sb_publishable_... on new Supabase projects

# --- the wallet gate (runs on the game server: POST /gate; see docs/decisions.md) ---
GATE_MODE=                                     # game. open (playtest: queue with a name, no DB) | required (wallet gate). Default: required in production, open otherwise
TURNSTILE_SECRET_KEY=                          # game. Bot check on queue entry; defaults to Cloudflare's always-pass test secret
HELIUS_API_KEY=                                # game, worker. Balance reads (getTokenAccountsByOwner) + RPC
SOLANA_RPC_URL=                                # game. ADDED: overrides the Helius URL (e.g. a local validator)
JUPITER_PRICE_URL=https://api.jup.ag/price/v3  # game. The spec's /price/v2 is deprecated
JUPITER_API_KEY=                               # game, worker. ADDED: Price v3 requires x-api-key
GATE_FIXED_PRICE_USD=                          # game. ADDED: devnet/localnet only, USD per whole test token (no price API quotes a devnet mint)
GATE_USD_MIN=30                                # game. Entry gate in USD
QUEUE_JWT_SECRET=                              # game. Signs queue tokens; >= 32 chars; unset = per-process random (one machine only)
QUOTE_MINT=                                    # worker. GME mint (verify on-chain before Phase 3)

# --- web: server ---
ADMIN_USER=                                    # web /admin (Phase 3)
ADMIN_PASS=
ADMIN_IP_ALLOWLIST=                            # comma-separated

# --- shared server ---
SOLANA_CLUSTER=devnet                          # all. devnet through Phase 3, mainnet-beta at launch
SUPABASE_URL=                                  # game, worker. Ranked results (record_match) and gate audits (record_gate)
SUPABASE_SERVICE_ROLE_KEY=                     # game, worker. sb_secret_...; never in the browser
UPSTASH_REDIS_URL=                             # web, game, worker (REST)
UPSTASH_REDIS_TOKEN=
REDIS_URL=                                     # game. ADDED (Phase 2): rediss:// TCP URL for the Colyseus driver
TELEGRAM_BOT_TOKEN=                            # worker, game. Alerts
TELEGRAM_CHAT_ID=

# --- local dev ---
WEB_PORT=3000                                  # web dev server port (pnpm dev); the game allows its origin by default

# --- game ---
PORT=2567
ALLOWED_ORIGINS=http://localhost:3000          # game. ADDED: matchmaking CORS allowlist, comma-separated

# --- worker (Phase 3; the Phase 0 worker is a health stub) ---
CREATOR_WALLET_KEYPAIR=                        # Fly secret only (base58 secret key). Launches token, receives fees
HOT_WALLET_KEYPAIR=                            # Fly secret only. Pays winners
MAX_PAYOUT_LAMPORTS=500000000                  # 0.5 SOL per payout cap
MAX_HOURLY_LAMPORTS=20000000000                # 20 SOL per hour cap
PAYOUT_P_MIN=0.005                             # SOL
PAYOUT_P_MAX=0.5                               # SOL
PAYOUT_M_FLOOR=200                             # matches
PLAYER_SHARE_BPS=7000                          # of claimed fees
DAILY_POOL_BPS=2000                            # of claimed fees; per-win budget = PLAYER_SHARE_BPS - DAILY_POOL_BPS
PAYOUT_CURRENCY=SOL                            # SOL | GME
DBC_POOL=                                      # Meteora DBC pool
DAMM_POOL=                                     # migrated DAMM v2 pool after graduation
PAYOUTS_ENABLED=false                          # ADDED: global kill switch
